{
  "name": "@boulotflash/database",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed/run.ts",
    "test": "jest --config jest.config.cjs",
    "test:constraints": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/check-constraints.sql"
  },
  "dependencies": {
    "@boulotflash/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.44.0",
    "pg": "8.23.1",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "jest": "30.5.2",
    "ts-jest": "^29.4.0",
    "tsx": "4.20.5",
    "typescript": "6.0.3"
  }
}
