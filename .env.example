# Copier vers .env.development / .env.test / .env.production (non versionnés).
# Remplacer les secrets OAuth par des valeurs factices non-placeholder avant docker compose up.

APP_ENV=development

# Postgres (réseau Compose interne)
POSTGRES_USER=boulotflash
POSTGRES_PASSWORD=boulotflash-dev-only
POSTGRES_DB=boulotflash
DATABASE_URL=postgresql://boulotflash:boulotflash-dev-only@postgres:5432/boulotflash

# Redis
REDIS_URL=redis://redis:6379

# MinIO / S3
S3_ACCESS_KEY=boulotflashminio
S3_SECRET_KEY=boulotflashminio-dev-only
S3_ENDPOINT=http://s3:9000
S3_PUBLIC_ENDPOINT=http://localhost/s3
S3_REGION=us-east-1
S3_BUCKET_MEDIA=boulotflash-dev-media
S3_BUCKET_PRIVATE=boulotflash-dev-private
# Clé KES d'évaluation locale uniquement (refusée en production) — 32 octets base64
MINIO_KMS_SECRET_KEY=boulotflash-local:dGVzdGtleXRlc3RrZXl0ZXN0a2V5dGVzdGtleXRlc3Q=
PRESIGN_MEDIA_TTL=900
PRESIGN_PRIVATE_TTL=300

# OAuth — obligatoires dans TOUS les APP_ENV (D34). Pas de OAUTH_ADAPTER.
# .env.example utilise des placeholders refusés au démarrage.
# Dans .env.development, mettre des chaînes factices non-placeholder (ex. local-dev-google-id).
GOOGLE_CLIENT_ID=replace-me-google-client-id
GOOGLE_CLIENT_SECRET=replace-me-google-client-secret
META_APP_ID=replace-me-meta-app-id
META_APP_SECRET=replace-me-meta-app-secret
GOOGLE_EMAIL_POLICY=verified_google

# JWT access HS256 (étape 08) — placeholder refusé au démarrage ; secret d’exemple refusé en production
JWT_SECRET=replace-me-jwt-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Hooks de test / seed — refusés si APP_ENV=production
ENABLE_TEST_HOOKS=true
SEED_DEMO=false

# Ports applicatifs internes (pas exposés sur l'hôte)
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002

# Ne pas définir FCM_* ni de clé Firebase Messaging (D36) — la garde refuse le démarrage.
