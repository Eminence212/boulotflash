{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "BoulotFlash",
    "version": "1.0.0",
    "inspiration": {
      "logo": "BoulotFlash adopté — squircle #3EA4FF + éclair blanc, Boulot/Flash italique, double swoosh sous Flash",
      "ui": "captures/ (Jobster) — fond pastel bleu, cartes blanches très arrondies, pills, hero recherche, catégories icônes"
    },
    "stack": {
      "ui": "Mantine UI (composants)",
      "utility": "Tailwind CSS (layout, spacing, responsive)",
      "icons": "Tabler Icons — https://tabler.io/icons (@tabler/icons-react)",
      "sourceOfTruth": "design/tokens/tokens.json → thème Mantine + preset Tailwind"
    }
  },
  "icons": {
    "library": "Tabler Icons",
    "url": "https://tabler.io/icons",
    "package": "@tabler/icons-react",
    "style": "outline",
    "defaultSize": 24,
    "defaultStroke": 2,
    "color": "currentColor",
    "rules": [
      "Une seule bibliothèque : Tabler Icons. Pas de Heroicons, Lucide, Font Awesome ou emoji comme icône UI.",
      "Style outline par défaut (grille 24×24, stroke 2).",
      "Couleur via currentColor / jetons — jamais de couleur en dur dans le SVG.",
      "Accessibilité : aria-hidden sur icône décorative ; aria-label sur ActionIcon seul."
    ]
  },
  "color": {
    "brand": {
      "flash": "#3EA4FF",
      "flashHover": "#2B8FE6",
      "flashSoft": "#E8F4FF",
      "flashMuted": "#B8DCFF",
      "ink": "#0B1220",
      "inkMuted": "#475569",
      "navy": "#0B111B",
      "navySoft": "#1A3358"
    },
    "surface": {
      "canvas": "#F0F5FA",
      "canvasTint": "#E8F0F8",
      "card": "#FFFFFF",
      "elevated": "#FFFFFF",
      "inverse": "#0B1220"
    },
    "border": {
      "subtle": "#D7E3F0",
      "strong": "#A8C0D9",
      "focus": "#3EA4FF"
    },
    "status": {
      "attente": { "fg": "#9A6700", "bg": "#FFF3CD", "label": "En attente" },
      "succes": { "fg": "#0F7B3A", "bg": "#D8F3E3", "label": "Confirmé" },
      "refus": { "fg": "#B42318", "bg": "#FEE4E2", "label": "Refusé" },
      "alerte": { "fg": "#B54708", "bg": "#FEF0C7", "label": "À traiter" }
    },
    "semantic": {
      "textPrimary": "#0B1220",
      "textSecondary": "#475569",
      "textOnBrand": "#FFFFFF",
      "textOnInverse": "#F8FAFC",
      "amount": "#0B1220",
      "time": "#0B1220",
      "commune": "#0B1220",
      "link": "#3EA4FF",
      "danger": "#B42318",
      "success": "#0F7B3A"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "\"Sora\", \"Plus Jakarta Sans\", system-ui, sans-serif",
      "body": "\"Plus Jakarta Sans\", \"Nunito Sans\", system-ui, sans-serif",
      "mono": "\"IBM Plex Mono\", ui-monospace, monospace"
    },
    "googleFontsImport": "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,600&family=Sora:wght@600;700;800&display=swap",
    "scale": {
      "display": {
        "size": "2.5rem",
        "lineHeight": 1.15,
        "weight": 800,
        "tracking": "-0.02em"
      },
      "h1": {
        "size": "2rem",
        "lineHeight": 1.2,
        "weight": 700,
        "tracking": "-0.02em"
      },
      "h2": {
        "size": "1.5rem",
        "lineHeight": 1.25,
        "weight": 700,
        "tracking": "-0.01em"
      },
      "h3": {
        "size": "1.25rem",
        "lineHeight": 1.3,
        "weight": 600,
        "tracking": "0"
      },
      "body": {
        "size": "1rem",
        "lineHeight": 1.55,
        "weight": 400,
        "tracking": "0"
      },
      "bodySm": {
        "size": "0.875rem",
        "lineHeight": 1.5,
        "weight": 400,
        "tracking": "0"
      },
      "label": {
        "size": "0.8125rem",
        "lineHeight": 1.4,
        "weight": 600,
        "tracking": "0.01em"
      },
      "caption": {
        "size": "0.75rem",
        "lineHeight": 1.4,
        "weight": 500,
        "tracking": "0.02em"
      }
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem"
  },
  "radius": {
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "2xl": "2rem",
    "pill": "9999px",
    "card": "1.5rem",
    "search": "2rem"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(11, 18, 32, 0.06)",
    "md": "0 8px 24px rgba(11, 31, 58, 0.08)",
    "lg": "0 16px 40px rgba(11, 31, 58, 0.12)",
    "brandGlow": "0 8px 24px rgba(62, 164, 255, 0.35)"
  },
  "touch": {
    "minHeight": "44px",
    "minWidth": "44px",
    "buttonPrimaryHeight": "48px",
    "iconButton": "44px"
  },
  "breakpoint": {
    "xs": "360px",
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1440px"
  },
  "motion": {
    "fast": "150ms",
    "base": "220ms",
    "slow": "350ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "layout": {
    "containerMax": "72rem",
    "gutterMobile": "1.25rem",
    "gutterDesktop": "2rem",
    "headerHeight": "4rem",
    "bottomNavHeight": "4rem"
  },
  "copy": {
    "brand": "BoulotFlash",
    "tagline": "Trouvez un travail aujourd’hui.",
    "tone": "vouvoiement",
    "language": "fr"
  }
}
